# Settings for the DeedOwl containers (not secrets). Edit, then:
#   systemctl daemon-reload && systemctl restart forced-sale-finder-web
#   (add --user to both commands for a rootless install)
BASE_URL=https://forced-sale-finder.example.com
ADMIN_USERNAME=admin
# 1 when a reverse proxy (like the Caddy container below) sits in front of the site.
TRUST_PROXY=1
# 1 = the domain is proxied through Cloudflare (orange cloud): use each visitor's own address (README: Cloudflare).
#TRUST_CLOUDFLARE=1
BACKUP_KEEP=7
# Email sender, verified in Postmark. The Postmark token is a Podman secret (fsf-postmark-token).
#MAIL_FROM=DeedOwl <no-reply@your-domain>
# Postal address for updates to the general email list only (CAN-SPAM). PO box is fine. Never shown on the site.
#MAIL_POSTAL_ADDRESS=PO Box 12345, Las Vegas, NV 89101
#MAIL_REPLY_TO=help@your-domain
# Postmark stream for updates to the general email list (admin → Email list). Default: broadcast
#POSTMARK_BROADCAST_STREAM=broadcast
