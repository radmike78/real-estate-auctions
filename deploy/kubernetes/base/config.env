# Non-secret settings. Edit BASE_URL and ADMIN_USERNAME before deploying.
# Secrets (admin password hash, signing key, Resend or Postmark key, Stripe keys) go in the Secret, not here.
BASE_URL=https://forced-sale-finder.example.com
ADMIN_USERNAME=admin
# 1 = trust the X-Forwarded-For header added by your Ingress controller or OpenShift router.
TRUST_PROXY=1
# 1 = the domain is proxied through Cloudflare (orange cloud): use each visitor's own address (README: Cloudflare).
#TRUST_CLOUDFLARE=1
BACKUP_KEEP=7
# Email sender, on a domain verified in Resend or Postmark (RESEND_API_KEY or POSTMARK_SERVER_TOKEN goes in
# the Secret). Uncomment to send email.
#MAIL_FROM=DeedOwl <no-reply@your-domain>
# Postal address for updates to the general email list only (CAN-SPAM). PO box is fine. Never shown on the site.
#MAIL_POSTAL_ADDRESS=PO Box 12345, Las Vegas, NV 89101
#MAIL_REPLY_TO=help@your-domain
# Resend only: sender for updates to the general email list, e.g. on a subdomain. Default: MAIL_FROM
#RESEND_BROADCAST_FROM=DeedOwl <news@updates.your-domain>
# Postmark only: stream for updates to the general email list (admin → Email list). Default: broadcast
#POSTMARK_BROADCAST_STREAM=broadcast
