{
  "name": "real-estate-auctions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p ingest && tsc --noEmit -p server && tsc --noEmit -p scripts && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ingest && tsc --noEmit -p server && tsc --noEmit -p scripts",
    "ingest": "tsx ingest/run.ts",
    "keys:generate": "tsx ingest/keygen.ts",
    "server": "tsx --no-warnings=ExperimentalWarning server/index.ts",
    "admin:hash-password": "tsx server/hash-password.ts",
    "content:status": "tsx scripts/content/cli.ts status",
    "content:reviewed": "tsx scripts/content/cli.ts reviewed",
    "content:check-sources": "tsx scripts/content/cli.ts check-sources"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "leaflet": "^1.9.4",
    "node-html-parser": "^9.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
